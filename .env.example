# Placeholders only. Never commit a real .env.
MONGODB_URI=
MONGODB_DATABASE=agent_engine_demo
MONGODB_WORKSPACE_COLLECTION=agent_workspaces
MONGODB_ARTIFACTS_COLLECTION=workspace_artifacts
MONGODB_RUNS_COLLECTION=agent_runs
MONGODB_HANDOFFS_COLLECTION=agent_handoffs
MONGODB_PACKS_COLLECTION=reviewer_packs
AWS_REGION=ap-south-1
S3_BUCKET=
S3_PREFIX=agent-engine-demo/
DEMO_DATASET_VERSION=v1
DEMO_WORKSPACE_ID=accrual_review_demo_2026_06
# VFS backend embeddings: bedrock (default, boto3 credential chain) | openai |
# deterministic (unit tests / offline only, non-production)
EMBEDDING_PROVIDER=bedrock
EMBEDDING_MODEL=
# LLM connection for the agent (see src/demo_agent/llm.py)
LLM_PROVIDER=openai
LLM_MODEL=
LLM_API_KEY=
# Platform invocation (UI / smoke): base URL of the deployed agent or local
# `agentengine dev up` stack, e.g. http://localhost:8000
AGENT_ENGINE_URL=
AGENT_ENGINE_API_KEY=
# s3 | local  (local = unit tests only, non-production)
S3_BACKEND=s3
LOCAL_S3_ROOT=data/generated/local_s3
LOG_LEVEL=INFO
