# Placeholders only. Never commit a real .env — copy this file to .env and
# fill in real values there (.env is gitignored).
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/
MONGODB_DATABASE=agent_engine_demo
MONGODB_WORKSPACE_COLLECTION=agent_workspaces
MONGODB_ARTIFACTS_COLLECTION=workspace_artifacts
MONGODB_RUNS_COLLECTION=agent_runs
MONGODB_HANDOFFS_COLLECTION=agent_handoffs
MONGODB_PACKS_COLLECTION=reviewer_packs
AWS_REGION=us-east-1
S3_BUCKET=<your-s3-bucket>
S3_PREFIX=agent-engine-demo/
DEMO_DATASET_VERSION=v1
DEMO_WORKSPACE_ID=accrual_review_demo_2026_06
# VFS backend embeddings: bedrock (default, boto3 credential chain) | openai |
# deterministic (unit tests / offline only, non-production)
EMBEDDING_PROVIDER=bedrock
EMBEDDING_MODEL=amazon.titan-embed-text-v2:0
# LLM connection for the agent (see src/demo_agent/llm.py).
# Available LLM_PROVIDER values:
#   bedrock     - default. AWS Bedrock Converse API; default LLM_MODEL:
#                 us.anthropic.claude-sonnet-4-5-20250929-v1:0 (inference
#                 profile — confirm the exact ID in the demo account).
#                 Credentials: boto3 default chain — set the AWS vars below if
#                 the chain doesn't resolve locally; deployed, they come from
#                 `agentengine secret set`. No LLM_API_KEY needed.
#   anthropic   - default LLM_MODEL: claude-sonnet-4-5;  key: LLM_API_KEY
#   openai      - default LLM_MODEL: gpt-4o-mini;        key: LLM_API_KEY
# LLM_MODEL is optional in all cases; leave empty to use the provider default.
# LLM_BASE_URL routes openai/anthropic calls through a corporate LLM gateway
# (must be an OpenAI- or Anthropic-compatible endpoint; ignored for bedrock).
# When set and deployed, allowlist the gateway host in agent.yaml egress
# (`agentengine agent egress add <host>:443`).
# LLM_AUTH_HEADER: set when the gateway wants the key in a custom header
# instead of `Authorization: Bearer` — e.g. `api-key` for Azure API
# Management subscriptions, or `x-api-key`. The LLM_API_KEY value is reused.
LLM_PROVIDER=bedrock
LLM_MODEL=
LLM_BASE_URL=
LLM_AUTH_HEADER=
AWS_ACCESS_KEY_ID=<aws-access-key-id>
AWS_SECRET_ACCESS_KEY=<aws-secret-access-key>
AWS_SESSION_TOKEN=<aws-session-token>   # only for temporary credentials
# LLM_API_KEY=         # only for LLM_PROVIDER=anthropic|openai

# Platform invocation (UI / smoke). Local: set AGENT_ENGINE_URL to the `ui`
# URL printed by `agentengine dev up` (e.g. http://localhost:3000). Deployed:
# leave AGENT_ENGINE_URL empty and set the two IDs (or run `agentengine init`,
# which writes them to .agentengine/state.json).
AGENT_ENGINE_URL=http://localhost:3000
AGENT_ENGINE_API_KEY=
AGENT_ENGINE_PROJECT_ID=
AGENT_ENGINE_WORKSPACE_ID=
# s3 | local  (local = unit tests only, non-production)
S3_BACKEND=s3
LOCAL_S3_ROOT=data/generated/local_s3
LOG_LEVEL=INFO
